# Velo Finance backend environment
# Copy to .env for the Node/Express API deployment.
# Never expose this file's secret values through VITE_* variables or commit a real .env.

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Neon PostgreSQL ---
# Use the pooled Neon connection string for the running API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a unique random value of at least 32 characters for non-development environments.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h

# --- Node admin login ---
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-admin-password
# Prefer a bcrypt hash in production; if set, it takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# --- Private document storage ---
# Use a private S3-compatible bucket or approved storage service.
DOCUMENT_STORAGE_BUCKET=velo-private-documents
DOCUMENT_STORAGE_ENDPOINT=https://storage.example.com
DOCUMENT_STORAGE_ACCESS_KEY=replace-me
DOCUMENT_STORAGE_SECRET_KEY=replace-me

# Google Drive document storage. Share the parent folder with this service-account email.
GOOGLE_DRIVE_PARENT_FOLDER_ID=replace-with-private-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=velo-document-storage@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
DOCUMENT_MAX_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# --- Flutterwave ---
# Use sandbox values for development and live values only in production secrets.
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace-me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_ENCRYPTION_KEY=replace-me-if-required-by-selected-flow
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-webhook-verification-secret

# --- Prembly identity and credit services ---
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=replace-me
PREMBLY_APP_ID=replace-me-if-required-by-selected-product

# --- KUDI SMS ---
KUDI_BASE_URL=https://my.kudisms.net/api
KUDI_API_KEY=replace-me
KUDI_SENDER_ID=VELO

# --- Meta WhatsApp Cloud API ---
META_GRAPH_API_VERSION=v21.0
META_WHATSAPP_ACCESS_TOKEN=replace-with-server-side-meta-token
META_WHATSAPP_APP_SECRET=replace-with-meta-app-secret
META_WHATSAPP_VERIFY_TOKEN=replace-with-random-webhook-verify-token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=replace-me
META_WHATSAPP_PHONE_NUMBER_ID=replace-me

# --- Email and repayment reminders ---
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=notifications@your-domain.com
BREVO_SENDER_NAME=Velo Finance
BRAND_LOGO_URL=https://your-domain.com/logo.png
LOAN_REMINDER_DAYS=7,3,0

# --- Loan eligibility policy ---
LOAN_AUTO_ELIGIBLE_SCORE_MIN=650
LOAN_AUTO_REVIEW_SCORE_MIN=550

# --- OTP policy ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
