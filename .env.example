# ============================================================
# Velo Finance LTD — Loan Application Frontend Configuration
# ============================================================
# Copy this file to ".env" and replace the placeholder values.
# NEVER put Google service-account credentials, OAuth client
# secrets, or any other private backend secrets here. Only
# PUBLIC frontend configuration belongs in VITE_* variables.
# ------------------------------------------------------------

# Express API base URL used by account access and role dashboards
VITE_API_URL=http://localhost:4000
VITE_PREMBLY_WIDGET_ID=
VITE_PREMBLY_WIDGET_KEY=

# --- Loan amount limits (in Naira) ---
VITE_LOAN_MIN_AMOUNT=100000
VITE_LOAN_MAX_AMOUNT=30000000
VITE_LOAN_DEFAULT_AMOUNT=3000000

# --- Available tenures (in days, comma-separated) ---
VITE_LOAN_TENURES=30,60,90,180

# --- Fee configuration ---
# Each fee supports either "flat" or "percentage"
#   flat        => fee = VITE_<NAME>_VALUE (absolute Naira amount)
#   percentage  => fee = loanAmount * VITE_<NAME>_VALUE / 100

# Interest (loan cost). Percentage values are monthly rates and scale by tenure / 30.
# Personal and business rates are configured independently. The generic value is the fallback.
VITE_INTEREST_TYPE=percentage
VITE_INTEREST_VALUE=5
VITE_PERSONAL_INTEREST_TYPE=percentage
VITE_PERSONAL_INTEREST_VALUE=5
VITE_BUSINESS_INTEREST_TYPE=percentage
VITE_BUSINESS_INTEREST_VALUE=5

# Service fee (upfront / application fee)
VITE_SERVICE_FEE_TYPE=percentage
VITE_SERVICE_FEE_VALUE=2

# Processing fee (upfront / application fee)
VITE_PROCESSING_FEE_TYPE=flat
VITE_PROCESSING_FEE_VALUE=5000

# Late fee (default fee — NOT included in initial repayment unless
# VITE_INCLUDE_LATE_FEE_UPFRONT is "true")
VITE_LATE_FEE_TYPE=percentage
VITE_LATE_FEE_VALUE=5
VITE_INCLUDE_LATE_FEE_UPFRONT=false

# --- Branding ---
VITE_COMPANY_NAME=Velo Finance LTD
VITE_COMPANY_WEBSITE=www.velofinance.co
